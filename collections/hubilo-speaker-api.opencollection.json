            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add/Update Speaker"
        },
        {
          "info": {
            "name": "List Speakers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hubilo.com/api/:apiVersion/integration/speaker/list",
            "params": [
              {
                "name": "apiVersion",
                "value": "",
                "type": "path",
                "description": "API version segment (e.g. v1)."
              }
            ]
          },
          "docs": "List Speakers"
        }
      ]
    }
  ],
  "bundled": true
